generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model DraftSession {
  id          String   @id @default(cuid())
  name        String
  leagueKey   String?
  draftSlot   Int
  stateJson   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlayerMapping {
  id             String   @id @default(cuid())
  sourceName     String
  sourcePosition String
  yahooPlayerId  String
  yahooName      String
  confirmedAt    DateTime @default(now())

  @@unique([sourceName, sourcePosition])
}

model DataImport {
  id          String   @id @default(cuid())
  source      String
  fetchedAt   DateTime @default(now())
  sourceDate  DateTime?
  playerCount Int
  checksum    String?
  payload     String

  @@index([source, fetchedAt])
}

model OAuthCredential {
  id                    String   @id
  provider              String   @default("yahoo")
  encryptedAccessToken  String
  encryptedRefreshToken String
  expiresAt             DateTime
  scope                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model LeagueConnection {
  id                   String   @id @default(cuid())
  provider             String   @default("yahoo")
  leagueKey            String   @unique
  leagueName           String?
  teamKey              String?
  teamName             String?
  draftSlot            Int?
  lastSuccessfulSyncAt DateTime?
  lastSyncError        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SyncCheckpoint {
  id         String   @id
  sequence   Int
  payload    String?
  syncedAt   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id                    String   @id @default(cuid())
  yahooGuid             String   @unique
  displayName           String
  role                  String   @default("member")
  status                String   @default("pending")
  encryptedAccessToken  String
  encryptedRefreshToken String
  expiresAt             DateTime
  scope                 String?
  draftSlot             Int?
  teamName              String?
  pinsJson              String   @default("[]")
  avoidsJson            String   @default("[]")
  waiverWatchJson       String   @default("[]")
  weightsJson           String?
  darkMode              Boolean  @default(false)
  lastSeenAt            DateTime?
  boardId               String?
  sleeperUsername       String?
  sleeperLeagueId       String?
  sleeperDraftId        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model LeagueDraft {
  id            String   @id @default("house-2026")
  leagueKey     String?
  mode          String   @default("mock")
  teamCount     Int      @default(12)
  rounds        Int      @default(15)
  picksJson     String   @default("[]")
  playersJson   String   @default("[]")
  importedAt    String   @default("Synthetic fixture")
  source        String   @default("Built-in mock data")
  storiesJson   String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DemoChatMessage {
  id         String   @id @default(cuid())
  roomId     String
  authorName String
  authorSlot Int
  kind       String
  content    String
  gifUrl     String?
  gifAlt     String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([roomId, createdAt])
  @@index([expiresAt])
}
