# Neon pooled URL for application traffic and direct URL for migrations.
DATABASE_URL="postgresql://user:password@pooler.example.neon.tech/database?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@example.neon.tech/database?sslmode=require"

# Public HTTPS URL for OAuth callbacks.
APP_URL="https://draft.example.com"

# Create an app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID="replace-with-yahoo-client-id"
YAHOO_CLIENT_SECRET="replace-with-yahoo-client-secret"
YAHOO_REDIRECT_URI="https://draft.example.com/api/yahoo/callback"
# Optional. Global fallback league key. Leave unset — the app resolves the
# league from the armed draft, the connected board, or auto-discovery.
# YAHOO_LEAGUE_KEY=""
# OpenID Profile only — do not request email. Add a Fantasy Sports scope later
# if Yahoo grants one (live draft sync).
YAHOO_OAUTH_SCOPE="openid profile"

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# Optional. No longer required to visit the site; still used as an HMAC fallback.
APP_ACCESS_PASSWORD="replace-with-a-long-random-password"
E2E_LOGIN_SECRET=""

# Optional. Hide FantasyPros in the expert dropdown when unset.
# Full boards need a paid HOF key (API Access is not included with MVP).
# HOF keys are 500 req/day — this app caches 12h (6 calls per refresh).
FANTASYPROS_API_KEY=""

# Optional. Enables GIF search in public demo-room chat.
GIPHY_API_KEY=""

# Optional. gpt-4o-mini writes the report-card story, share line, and room invite punchline.
OPENAI_API_KEY=""

# Read-only sync controls
YAHOO_SYNC_ENABLED="false"
YAHOO_POLL_INTERVAL_MS="15000"

# Future selection behavior is deliberately unavailable and disabled.
AUTO_SELECTION_ENABLED="false"
AUTO_SELECTION_MIN_CONFIDENCE="0.90"

# Public Boris Chen lists; override only with a permitted source.
# The board defaults to 0.5 PPR. The UI can fetch the other two.
CHEN_HALF_PPR_CSV_URL="https://s3-us-west-1.amazonaws.com/fftiers/out/weekly-ALL-HALF-PPR.csv"
CHEN_PPR_CSV_URL="https://s3-us-west-1.amazonaws.com/fftiers/out/weekly-ALL-PPR.csv"
CHEN_STANDARD_CSV_URL="https://s3-us-west-1.amazonaws.com/fftiers/out/weekly-ALL.csv"
# Kickers are a separate Chen file; the ALL lists omit them.
CHEN_K_CSV_URL="https://s3-us-west-1.amazonaws.com/fftiers/out/weekly-K.csv"
